ENVIRONMENT="production"
APP_NAME="Fast Crews"
APP_DESCRIPTION="Gateway to AI services"
APP_VERSION="0.1"
CONTACT_NAME="AIsee Support"
CONTACT_EMAIL="support@aisee.art"
LICENSE_NAME="MIT"
DEBUG=false

# JWT and auth
SECRET_KEY="replace-with-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM provider key (required for CrewAI image analyzer and poem generation)
OPENROUTER_API_KEY="replace-with-openrouter-api-key"

# RDS PostgreSQL (external)
POSTGRES_USER="aisee_admin"
POSTGRES_PASSWORD="replace-with-rds-password"
POSTGRES_SERVER="aisee-db.czqsu6aywl9d.eu-north-1.rds.amazonaws.com"
POSTGRES_PORT=5432
POSTGRES_DB="aisee"
POSTGRES_SYNC_PREFIX="postgresql://"
POSTGRES_ASYNC_PREFIX="postgresql+asyncpg://"

# Redis (local on EC2, from Docker network)
REDIS_CACHE_HOST="redis"
REDIS_CACHE_PORT=6379
REDIS_QUEUE_HOST="redis"
REDIS_QUEUE_PORT=6379

# Storage backend
STORAGE_BACKEND="s3"
LOCAL_STORAGE_ROOT="."
S3_BUCKET_NAME="aisee-art-media"
S3_REGION="eu-north-1"
S3_ENDPOINT_URL=None
S3_MEDIA_PREFIX="media"
S3_OUTPUT_PREFIX="output"
S3_SIGNED_URL_EXPIRE_SECONDS=3600
# Optional for local/dev or non-IAM auth
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_SESSION_TOKEN="..."
# AWS_PROFILE="default"

# CORS must be a JSON array for list[str]
CORS_ORIGINS='["https://aisee.art","https://www.aisee.art"]'

# First superuser bootstrap
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@aisee.art"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-strong-password"

# Admin panel hardening
CRUD_ADMIN_ENABLED=true
CRUD_ADMIN_MOUNT_PATH="/admin"
CRUD_ADMIN_ALLOWED_IPS_LIST=None
CRUD_ADMIN_ALLOWED_NETWORKS_LIST=None
CRUD_ADMIN_MAX_SESSIONS=10
CRUD_ADMIN_SESSION_TIMEOUT=1440
SESSION_SECURE_COOKIES=true
CRUD_ADMIN_TRACK_EVENTS=true
CRUD_ADMIN_TRACK_SESSIONS=true
CRUD_ADMIN_REDIS_ENABLED=false
CRUD_ADMIN_REDIS_HOST="redis"
CRUD_ADMIN_REDIS_PORT=6379
CRUD_ADMIN_REDIS_DB=0
CRUD_ADMIN_REDIS_PASSWORD=None
CRUD_ADMIN_REDIS_SSL=false

# Logging
FILE_LOG_MAX_BYTES=10485760
FILE_LOG_BACKUP_COUNT=5
FILE_LOG_FORMAT_JSON=true
FILE_LOG_LEVEL="INFO"
FILE_LOG_INCLUDE_REQUEST_ID=true
FILE_LOG_INCLUDE_PATH=true
FILE_LOG_INCLUDE_METHOD=true
FILE_LOG_INCLUDE_CLIENT_HOST=true
FILE_LOG_INCLUDE_STATUS_CODE=true
CONSOLE_LOG_LEVEL="INFO"
CONSOLE_LOG_FORMAT_JSON=false
CONSOLE_LOG_INCLUDE_REQUEST_ID=false
CONSOLE_LOG_INCLUDE_PATH=false
CONSOLE_LOG_INCLUDE_METHOD=false
CONSOLE_LOG_INCLUDE_CLIENT_HOST=false
CONSOLE_LOG_INCLUDE_STATUS_CODE=false

# Client cache
CLIENT_CACHE_MAX_AGE=60

# CORS must be JSON arrays for list[str]
CORS_METHODS='["*"]'
CORS_HEADERS='["*"]'

# SMTP / verification email
SMTP_HOST=None
SMTP_PORT=587
SMTP_USERNAME=None
SMTP_PASSWORD=None
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
EMAIL_FROM_NAME="AIsee.art"
EMAIL_FROM_ADDRESS=None
EMAIL_REPLY_TO=None
EMAIL_VERIFICATION_BASE_URL=None
EMAIL_VERIFICATION_EXPIRE_DAYS=3

# Optional AWS auth values; set to None when using IAM role
AWS_ACCESS_KEY_ID=None
AWS_SECRET_ACCESS_KEY=None
AWS_SESSION_TOKEN=None
AWS_PROFILE=None
